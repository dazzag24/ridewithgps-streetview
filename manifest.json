{
  "manifest_version": 3,
  "name": "RideWithGPS Street View",
  "version": "1.0.0",
  "description": "Pick a point on a RideWithGPS route and preview it in Google Street View.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://ridewithgps.com/*"],
      "js": ["content/streetview.js"],
      "css": ["content/streetview.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rwgps-streetview@example.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
